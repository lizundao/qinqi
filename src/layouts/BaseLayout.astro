---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../data/site';
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = SITE.description,
  keywords,
  ogType = 'website',
  publishedTime,
  jsonLd = [],
} = Astro.props;

const pathname = Astro.url.pathname;
const path = pathname.endsWith('/') ? pathname : `${pathname}/`;
const canonical = new URL(path, SITE.url).href;
const ogImage = new URL(SITE.ogImage, SITE.url).href;
const pageTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;

const graphs = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
    inLanguage: 'zh-CN',
  },
  ...jsonLd,
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/images/logo-512.png" />
    <meta name="theme-color" content="#2E6BEF" />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {graphs.map((graph) => (
      <script type="application/ld+json" set:html={JSON.stringify(graph)} is:inline />
    ))}

    <script is:inline>
      (() => {
        const key = 'qinqi-theme';
        // 默认浅色，与微信小程序蓝色品牌一致；用户手动切换后记住选择
        const stored = localStorage.getItem(key);
        const theme = stored === 'dark' || stored === 'light' ? stored : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

    <script is:inline>
      const toggle = document.getElementById('theme-toggle');
      if (toggle) {
        toggle.setAttribute(
          'aria-label',
          document.documentElement.dataset.theme === 'dark' ? '切换到浅色模式' : '切换到深色模式'
        );
      }
      toggle?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('qinqi-theme', next);
        toggle.setAttribute('aria-label', next === 'dark' ? '切换到浅色模式' : '切换到深色模式');
      });
    </script>
  </body>
</html>
