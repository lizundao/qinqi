---
import HeroQrCode from './HeroQrCode.astro';

interface Props {
	title?: string;
	tagline?: string;
}

const {
	title = '亲戚百科',
	tagline = '搞清楚舅妈、舅公怎么叫——本地查称呼，不上传隐私。',
} = Astro.props;
---

<div class="hero grid grid-cols-1 items-center gap-10 pb-6 lg:grid-cols-2 lg:gap-14 lg:pb-10 lg:pt-4">
	<div class="flex flex-col gap-7 text-center lg:text-left">
		<div class="flex flex-col items-center gap-4 lg:items-start">
			<h1
				class="font-brand max-w-[14ch] text-[clamp(2.125rem,calc(0.5rem+5vw),3.75rem)] font-normal leading-[1.15] tracking-[0.04em] text-ink dark:text-stone-100"
			>
				{title}
			</h1>
			<p
				class="max-w-md text-[clamp(1rem,0.5vw+0.95rem,1.125rem)] leading-[1.75] text-ink-muted dark:text-stone-400"
			>
				{tagline}
			</p>
		</div>

		<div class="flex flex-wrap items-center justify-center gap-4 lg:justify-start">
			<a href="/calc/" class="qq-btn-primary">
				查称呼
				<svg
					class="h-4 w-4"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2.5"
					aria-hidden="true"
				>
					<path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
			</a>
			<a href="/articles/" class="qq-link text-sm">
				读亲戚常识 →
			</a>
		</div>
	</div>

	<div class="flex w-full items-center justify-center lg:justify-end">
		<HeroQrCode />
	</div>
</div>
