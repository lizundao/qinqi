---
import logo from '../assets/logo.svg';
import logoDark from '../assets/logo-dark.svg';

const navItems = [
	{ label: '在线计算器', href: '/calc/' },
	{ label: '亲戚常识', href: '/articles/' },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string) {
	const target = href.replace(/\/$/, '') || '/';
	if (target === '/articles') {
		return pathname === '/articles' || pathname.startsWith('/articles/');
	}
	return pathname === target;
}

const linkBase =
	'relative border-b-2 border-transparent px-3 py-2 text-sm font-medium text-ink-muted no-underline whitespace-nowrap transition hover:text-ink dark:text-stone-400 dark:hover:text-stone-200 max-[49.9rem]:px-2 max-[49.9rem]:py-1.5 max-[49.9rem]:text-[0.82rem]';
const linkActive =
	'border-brand font-semibold text-brand dark:border-red-500 dark:text-red-400';
---

<div class="site-container">
<div class="site-header-inner flex h-full w-full items-center gap-3 max-[49.9rem]:flex-wrap max-[49.9rem]:gap-y-1.5">
	<div class="title-wrapper flex min-w-0 flex-none overflow-clip p-1 -m-1 max-[49.9rem]:flex-1">
		<a
			href="/"
			class="site-title inline-flex items-center gap-2 text-ink no-underline dark:text-stone-100"
		>
			<img class="h-7 w-7 dark:hidden" src={logo.src} width="28" height="28" alt="" />
			<img class="hidden h-7 w-7 dark:block" src={logoDark.src} width="28" height="28" alt="" />
			<span>亲戚百科</span>
		</a>
	</div>

	<div class="header-spacer min-w-0 flex-1 max-[49.9rem]:hidden" aria-hidden="true"></div>

	<div
		class="header-end flex min-w-0 flex-none flex-row flex-nowrap items-center gap-2.5 print:hidden max-[49.9rem]:w-full max-[49.9rem]:flex-wrap max-[49.9rem]:justify-end"
	>
		<slot name="search" />
		<nav class="top-nav flex shrink-0 items-center gap-1" aria-label="主导航">
			{
				navItems.map((item) => (
					<a href={item.href} class:list={[linkBase, isActive(item.href) && linkActive]}>
						{item.label}
					</a>
				))
			}
		</nav>
		<div class="header-tools flex shrink-0 items-center gap-3.5">
			<div
				class="social-icons flex items-center gap-4 after:h-8 after:border-e after:border-stone-300 dark:after:border-stone-600"
			>
				<a
					href="https://github.com/lizundao/qinqi"
					class="flex text-ink-muted no-underline transition hover:text-ink dark:text-stone-400 dark:hover:text-stone-200"
					target="_blank"
					rel="noopener"
					aria-label="GitHub"
				>
					<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path
							d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z"
						></path>
					</svg>
				</a>
			</div>
			<slot name="theme" />
		</div>
	</div>
</div>
</div>

<script is:inline>
	(() => {
		const key = 'starlight-theme';
		const stored = typeof localStorage !== 'undefined' ? localStorage.getItem(key) : null;
		const theme =
			stored || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
		document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';

		document.getElementById('theme-toggle')?.addEventListener('click', () => {
			const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
			document.documentElement.dataset.theme = next;
			localStorage.setItem(key, next);
		});
	})();
</script>
