---
import { SITE, NAV } from '../data/site';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string) {
  if (href.startsWith('/#')) return false;
  const target = href.replace(/\/$/, '') || '/';
  if (target === '/') return pathname === '/';
  return pathname === target || pathname.startsWith(`${target}/`);
}
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label={`${SITE.name}首页`}>
      <img class="brand__mark" src="/favicon.svg" width="36" height="36" alt="" />
      <span class="brand__name">{SITE.name}</span>
    </a>

    <nav class="nav" aria-label="主导航">
      {NAV.map((item) => (
        <a class:list={['nav__link', isActive(item.href) && 'is-active']} href={item.href}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <button
        id="theme-toggle"
        class="icon-btn"
        type="button"
        aria-label="切换到深色模式"
        title="切换深浅色"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <a
        class="icon-btn"
        href={SITE.github}
        target="_blank"
        rel="noopener"
        aria-label="GitHub 源码"
        title="GitHub 源码"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57l-.01-2.04c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z" />
        </svg>
      </a>
    </div>
  </div>
</header>
