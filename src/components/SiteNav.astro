---
import logo from '../assets/logo.svg';
import logoDark from '../assets/logo-dark.svg';

const navItems = [
	{ label: '在线计算器', href: '/calc/' },
	{ label: '亲戚常识', href: '/articles/' },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string) {
	const target = href.replace(/\/$/, '') || '/';
	if (target === '/articles') {
		return pathname === '/articles' || pathname.startsWith('/articles/');
	}
	return pathname === target;
}

const linkBase =
	'rounded-full px-3 py-1.5 text-sm font-medium text-slate-500 no-underline transition hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-100';
const linkActive =
	'bg-blue-50 font-semibold text-brand-dark dark:bg-blue-950/50 dark:text-blue-300';
---

<header
	class="border-b border-slate-200/80 bg-slate-50/90 backdrop-blur-md dark:border-slate-800 dark:bg-slate-950/90"
>
	<div class="mx-auto flex max-w-[90rem] flex-wrap items-center gap-4 px-4 py-2.5 sm:px-6 lg:px-8">
	<a
		href="/"
		class="inline-flex items-center gap-2 text-[0.95rem] font-bold tracking-wide text-slate-800 no-underline dark:text-slate-100"
	>
		<img class="h-7 w-7 dark:hidden" src={logo.src} width="28" height="28" alt="" />
		<img class="hidden h-7 w-7 dark:block" src={logoDark.src} width="28" height="28" alt="" />
		<span>亲戚百科</span>
	</a>

	<nav class="ml-auto flex items-center gap-0.5 max-sm:order-3 max-sm:ml-0 max-sm:w-full max-sm:justify-end" aria-label="主导航">
		{
			navItems.map((item) => (
				<a href={item.href} class:list={[linkBase, isActive(item.href) && linkActive]}>
					{item.label}
				</a>
			))
		}
	</nav>

	<div class="flex items-center gap-2">
		<a
			href="https://github.com/lizundao/qinqi"
			class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-slate-500 no-underline transition hover:bg-slate-100 hover:text-slate-800 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-100"
			target="_blank"
			rel="noopener"
			aria-label="GitHub"
		>
			<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path
					d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z"
				></path>
			</svg>
		</a>
		<button
			type="button"
			class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-slate-500 transition hover:bg-slate-100 hover:text-slate-800 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-100"
			id="theme-toggle"
			aria-label="切换主题"
		>
			<svg class="dark:hidden" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
				<path
					d="M5 12a1 1 0 0 0-1-1H3a1 1 0 0 0 0 2h1a1 1 0 0 0 1-1Zm.64 5-.71.71a1 1 0 0 0 0 1.41 1 1 0 0 0 1.41 0l.71-.71A1 1 0 0 0 5.64 17ZM12 5a1 1 0 0 0 1-1V3a1 1 0 0 0-2 0v1a1 1 0 0 0 1 1Zm5.66 2.34a1 1 0 0 0 .7-.29l.71-.71a1 1 0 1 0-1.41-1.41l-.66.71a1 1 0 0 0 0 1.41 1 1 0 0 0 .66.29Zm-12-.29a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.71-.71a1.004 1.004 0 1 0-1.43 1.41l.73.71ZM21 11h-1a1 1 0 0 0 0 2h1a1 1 0 0 0 0-2Zm-2.64 6A1 1 0 0 0 17 18.36l.71.71a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.76-.66ZM12 6.5a5.5 5.5 0 1 0 5.5 5.5A5.51 5.51 0 0 0 12 6.5Zm0 9a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7Zm0 3.5a1 1 0 0 0-1 1v1a1 1 0 0 0 2 0v-1a1 1 0 0 0-1-1Z"
				></path>
			</svg>
			<svg class="hidden dark:block" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
				<path
					d="M21.64 13a1 1 0 0 0-1.05-.14 8.049 8.049 0 0 1-3.37.73 8.15 8.15 0 0 1-8.14-8.1 8.59 8.59 0 0 1 .25-2A1 1 0 0 0 8 2.36a10.14 10.14 0 1 0 14 11.69 1 1 0 0 0-.36-1.05Zm-9.5 6.69A8.14 8.14 0 0 1 7.08 5.22v.27a10.15 10.15 0 0 0 10.14 10.14 9.784 9.784 0 0 0 2.1-.22 8.11 8.11 0 0 1-7.18 4.32v-.04Z"
				></path>
			</svg>
		</button>
	</div>
	</div>
</header>

<script is:inline>
	(() => {
		const key = 'starlight-theme';
		const stored = typeof localStorage !== 'undefined' ? localStorage.getItem(key) : null;
		const theme =
			stored || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
		document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';

		document.getElementById('theme-toggle')?.addEventListener('click', () => {
			const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
			document.documentElement.dataset.theme = next;
			localStorage.setItem(key, next);
		});
	})();
</script>
