---
import { getArticles, getArticleHref, getArticleCover } from '../utils/articles';
import ArticleCover from './ArticleCover.astro';

const articles = await getArticles();

function formatDate(date: Date | undefined) {
	if (!date) return '';
	return date.toLocaleDateString('zh-CN', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	});
}

function searchText(title: string, description: string | undefined, tags: string[] | undefined) {
	return [title, description ?? '', ...(tags ?? [])].join(' ').toLowerCase();
}
---

<div class="articles-page mx-auto w-full max-w-6xl">
	<header class="mb-8 md:mb-10">
		<h1 class="font-display text-2xl font-bold tracking-tight text-ink md:text-[1.75rem] dark:text-stone-100">
			亲戚常识
		</h1>
		<p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-muted md:text-[0.9375rem] dark:text-stone-400">
			俗语典故与亲缘辨析，帮你理智看待血缘、体面处理家庭关系——谁该亲近、如何相处、为何讲究。
		</p>
		<p class="mt-3 text-xs text-stone-400 dark:text-stone-500">共 {articles.length} 篇</p>
	</header>

	<label class="mb-8 block md:mb-10">
		<span class="sr-only">搜索文章</span>
		<div class="relative">
			<svg
				class="pointer-events-none absolute top-1/2 left-4 h-4 w-4 -translate-y-1/2 text-stone-400"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				aria-hidden="true"
			>
				<circle cx="11" cy="11" r="7"></circle>
				<path d="M20 20l-3.5-3.5" stroke-linecap="round"></path>
			</svg>
			<input
				id="articles-search"
				type="search"
				placeholder="搜索文章标题、摘要或标签…"
				autocomplete="off"
				class="w-full rounded-lg border border-stone-200/90 bg-white py-3.5 pr-4 pl-11 text-sm text-ink outline-none transition placeholder:text-stone-400 focus:border-indigo focus:ring-2 focus:ring-indigo/15 dark:border-stone-700 dark:bg-night-card dark:text-stone-100 dark:placeholder:text-stone-500 dark:focus:border-stone-500"
			/>
		</div>
	</label>

	{
		articles.length === 0 ? (
			<p class="rounded-lg border border-dashed border-stone-300 px-4 py-12 text-center text-sm text-ink-muted dark:border-stone-700 dark:text-stone-400">
				暂无文章，请在{' '}
				<code class="rounded bg-stone-100 px-1 dark:bg-stone-800">src/content/docs/articles/</code> 添加内容。
			</p>
		) : (
			<>
				<ul
					id="articles-list"
					class="grid list-none gap-4 p-0 md:grid-cols-2 md:gap-5 xl:grid-cols-3"
				>
					{
						articles.map((article) => {
							const cover = getArticleCover(article);
							return (
							<li
								data-article-item
								data-search={searchText(
									article.data.title,
									article.data.description,
									article.data.tags,
								)}
							>
								<a
									class="article-card qq-card group flex h-full flex-col text-inherit no-underline"
									href={getArticleHref(article)}
								>
									{cover && (
										<ArticleCover src={cover} alt={article.data.title} variant="card" />
									)}
									<div class="flex flex-1 flex-col p-5 sm:p-6">
										<div class="flex flex-1 flex-col gap-2.5">
											<h2 class="line-clamp-2 text-base font-semibold leading-snug text-ink transition group-hover:text-brand dark:text-stone-100 dark:group-hover:text-red-400">
												{article.data.title}
											</h2>
											{
												article.data.description && (
													<p class="line-clamp-3 text-sm leading-[1.65] text-ink-muted dark:text-stone-400">
														{article.data.description}
													</p>
												)
											}
										</div>

										<div class="mt-5 flex flex-wrap items-center gap-1.5 border-t border-stone-100 pt-4 dark:border-stone-800">
											{
												article.data.date && (
													<time
														class="text-xs text-ink-muted dark:text-stone-400"
														datetime={article.data.date.toISOString()}
													>
														{formatDate(article.data.date)}
													</time>
												)
											}
											{
												article.data.tags?.map((tag) => (
													<span class="qq-tag px-2.5 py-0.5 text-xs">{tag}</span>
												))
											}
										</div>
									</div>
								</a>
							</li>
							);
						})
					}
				</ul>

				<p
					id="articles-empty"
					class="hidden rounded-lg border border-dashed border-stone-300 px-4 py-12 text-center text-sm text-ink-muted dark:border-stone-700 dark:text-stone-400"
				>
					没有找到匹配的文章，试试其他关键词。
				</p>

				<nav
					id="articles-pagination"
					class="mt-10 flex items-center justify-center gap-3 md:mt-12"
					aria-label="文章分页"
				/>
			</>
		)
	}
</div>

<script src="../scripts/articles-page.ts"></script>
