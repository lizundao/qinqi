---
const year = new Date().getFullYear();

const navItems = [
	{ label: '首页', href: '/' },
	{ label: '在线计算器', href: '/calc/' },
	{ label: '亲戚常识', href: '/articles/' },
	{ label: '关于', href: '/about/' },
];
---

<footer class="site-footer mt-auto border-t border-slate-200/80 bg-slate-50/90 dark:border-slate-800 dark:bg-slate-950/90">
	<div class="mx-auto max-w-[90rem] px-4 py-8 sm:px-6 lg:px-8 lg:py-10">
		<div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
			<div class="space-y-2">
				<a
					href="/"
					class="inline-block text-[0.95rem] font-bold tracking-wide text-slate-800 no-underline dark:text-slate-100"
				>
					亲戚百科
				</a>
				<p class="max-w-sm text-sm leading-relaxed text-slate-500 dark:text-slate-400">
					算关系、读常识，读懂中国式亲戚文化。
				</p>
			</div>

			<nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="页脚导航">
				{
					navItems.map((item) => (
						<a
							href={item.href}
							class="text-sm text-slate-500 no-underline transition hover:text-brand dark:text-slate-400 dark:hover:text-blue-400"
						>
							{item.label}
						</a>
					))
				}
			</nav>
		</div>

		<div
			class="mt-6 flex flex-col gap-3 border-t border-slate-200/70 pt-6 text-xs text-slate-400 sm:flex-row sm:items-center sm:justify-between dark:border-slate-800 dark:text-slate-500"
		>
			<p>© {year} 亲戚百科 · qinqi.wiki</p>
			<a
				href="https://github.com/lizundao/qinqi"
				class="inline-flex items-center gap-1.5 text-slate-400 no-underline transition hover:text-slate-600 dark:hover:text-slate-300"
				target="_blank"
				rel="noopener"
			>
				<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path
						d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z"
					></path>
				</svg>
				GitHub
			</a>
		</div>
	</div>
</footer>
