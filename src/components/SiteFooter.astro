---
import { SITE, NAV } from '../data/site';
import { TOPICS, topicHref } from '../data/topics';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a class="brand" href="/">
          <img class="brand__mark" src="/favicon.svg" width="36" height="36" alt="" />
          <span class="brand__name">{SITE.name}</span>
        </a>
        <p>
          把亲戚关系一次算清楚。关系链、称呼正反查、方言叫法都在浏览器本地完成；
          另有亲戚常识文章，讲清称呼背后的亲缘与分寸。
        </p>
      </div>

      <div class="footer__col">
        <h3>工具</h3>
        {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href="/calc/?chain=%E7%88%B6%E7%9A%84%E7%88%B6">试试「爷爷」怎么算</a>
      </div>

      <div class="footer__col">
        <h3>亲戚常识栏目</h3>
        {TOPICS.slice(0, 5).map((topic) => <a href={topicHref(topic.slug)}>{topic.title}</a>)}
        <a href="/articles/">全部文章</a>
      </div>

      <div class="footer__col">
        <h3>关于</h3>
        <a href="/about/">关于本站</a>
        <a href="/llms.txt">llms.txt</a>
        <a href="/sitemap.xml">站点地图</a>
        <a href={SITE.github} target="_blank" rel="noopener">GitHub 源码</a>
        <a href={SITE.lib} target="_blank" rel="noopener">relationship.js</a>
      </div>
    </div>

    <div class="footer__bottom">
      <span>© {year} {SITE.name} · 内容与算法开源，计算在你本机完成</span>
      <span>算法基于 relationship.js v{SITE.libVersion}（MIT）· 微信小程序「{SITE.appName}」同源</span>
    </div>
  </div>
</footer>
