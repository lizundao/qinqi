---
const tokens = [
	{ label: '父', value: '爸爸' },
	{ label: '母', value: '妈妈' },
	{ label: '夫', value: '老公' },
	{ label: '妻', value: '老婆' },
	{ label: '兄', value: '哥哥' },
	{ label: '弟', value: '弟弟' },
	{ label: '姐', value: '姐姐' },
	{ label: '妹', value: '妹妹' },
	{ label: '子', value: '儿子' },
	{ label: '女', value: '女儿' },
];

const examples = ['妈妈的妈妈的兄弟', '七舅姥爷', '舅妈如何称呼外婆？', '哥哥的儿子'];

const segBtn = 'calc-seg-btn';
const segGroup =
	'grid grid-cols-2 gap-1 rounded-xl bg-slate-100/90 p-1 dark:bg-slate-800/70';
const actionBtn =
	'rounded-xl border border-slate-200/90 bg-white px-4 py-3 text-sm font-medium text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-slate-500 dark:hover:bg-slate-800';
---

<div class="relative isolate">
	<div
		class="pointer-events-none absolute inset-x-0 -top-8 -z-10 h-[28rem] bg-[radial-gradient(ellipse_80%_60%_at_50%_-10%,rgba(37,99,235,0.12),transparent)] dark:bg-[radial-gradient(ellipse_80%_60%_at_50%_-10%,rgba(37,99,235,0.18),transparent)]"
		aria-hidden="true"
	>
	</div>

	<div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
		<header class="mb-8 md:mb-10">
			<p class="mb-2 text-sm font-semibold tracking-widest text-brand uppercase dark:text-blue-400">
				在线工具
			</p>
			<h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
				亲戚关系计算器
			</h1>
			<p class="mt-3 max-w-2xl text-base leading-relaxed text-slate-500 dark:text-slate-400">
				输入关系链或称呼，浏览器本地即时算出结果。支持反向查询与自然语言问法。
			</p>
		</header>

		<div class="grid items-start gap-6 lg:grid-cols-12 lg:gap-8">
			<!-- 左侧：输入与操作 -->
			<div
				class="rounded-2xl border border-slate-200/80 bg-white/90 p-5 shadow-sm backdrop-blur-sm sm:p-6 lg:col-span-7 dark:border-slate-700/80 dark:bg-slate-900/90"
			>
				<label class="mb-2 block text-sm font-medium text-slate-600 dark:text-slate-300" for="calc-input">
					关系 / 称呼
				</label>
				<div class="flex flex-col gap-3 sm:flex-row">
					<input
						id="calc-input"
						class="min-w-0 flex-1 rounded-xl border border-slate-200 bg-slate-50/80 px-4 py-3.5 text-base text-slate-900 shadow-inner outline-none transition placeholder:text-slate-400 focus:border-brand focus:ring-4 focus:ring-blue-500/15 dark:border-slate-600 dark:bg-slate-950/80 dark:text-slate-100 dark:placeholder:text-slate-500"
						type="text"
						placeholder="妈妈的妈妈的兄弟，或：七舅姥爷"
						autocomplete="off"
						spellcheck="false"
					/>
					<button
						type="button"
						id="calc-run"
						class="shrink-0 rounded-xl bg-brand px-8 py-3.5 text-base font-semibold text-white shadow-md shadow-blue-500/25 transition hover:bg-brand-dark hover:shadow-lg hover:shadow-blue-500/30 sm:min-w-[7rem]"
					>
						计算
					</button>
				</div>

				<div class="mt-5">
					<p class="mb-2.5 text-xs font-medium tracking-wide text-slate-400 uppercase dark:text-slate-500">
						快捷输入
					</p>
					<div class="grid grid-cols-5 gap-2 sm:grid-cols-10" id="calc-shortcuts">
						{
							tokens.map((t) => (
								<button
									type="button"
									class="calc-token-btn flex aspect-square items-center justify-center rounded-xl border border-slate-200/90 bg-white text-sm font-semibold text-slate-700 shadow-sm transition hover:-translate-y-0.5 hover:border-brand hover:bg-blue-50 hover:text-brand hover:shadow-md disabled:cursor-not-allowed disabled:border-slate-200/60 disabled:bg-slate-100 disabled:text-slate-300 disabled:opacity-40 disabled:shadow-none disabled:hover:translate-y-0 disabled:hover:border-slate-200/60 disabled:hover:bg-slate-100 disabled:hover:text-slate-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-blue-500 dark:hover:bg-blue-950/60 dark:hover:text-blue-300 dark:disabled:border-slate-700 dark:disabled:bg-slate-800 dark:disabled:text-slate-600"
									data-token={t.value}
									data-spouse={t.value === '老公' ? 'husband' : t.value === '老婆' ? 'wife' : undefined}
								>
									{t.label}
								</button>
							))
						}
					</div>
				</div>

				<div class="mt-5 flex flex-wrap items-center gap-2" id="calc-examples">
					<span class="text-sm text-slate-400 dark:text-slate-500">试试</span>
					{
						examples.map((ex) => (
							<button
								type="button"
								class="rounded-full border border-slate-200/80 bg-slate-50 px-3 py-1 text-sm text-slate-600 transition hover:border-blue-200 hover:bg-blue-50 hover:text-brand dark:border-slate-600 dark:bg-slate-800/80 dark:text-slate-300 dark:hover:border-blue-800 dark:hover:bg-blue-950/50 dark:hover:text-blue-300"
								data-example={ex}
							>
								{ex}
							</button>
						))
					}
				</div>

				<div class="mt-6 grid gap-4 border-t border-slate-200/80 pt-6 sm:grid-cols-3 dark:border-slate-700/80">
					<div>
						<span class="mb-2 block text-xs font-medium text-slate-500 dark:text-slate-400">我的性别</span>
						<div class={segGroup} data-option="sex">
							<button type="button" class:list={[segBtn, 'is-on']} data-value="1">男</button>
							<button type="button" class={segBtn} data-value="0">女</button>
						</div>
					</div>
					<div>
						<span class="mb-2 block text-xs font-medium text-slate-500 dark:text-slate-400">称呼方向</span>
						<div class={segGroup} data-option="reverse">
							<button type="button" class:list={[segBtn, 'is-on']} data-value="false">我称呼对方</button>
							<button type="button" class={segBtn} data-value="true">对方称呼我</button>
						</div>
					</div>
					<div>
						<span class="mb-2 block text-xs font-medium text-slate-500 dark:text-slate-400">计算类型</span>
						<div class={segGroup} data-option="type">
							<button type="button" class:list={[segBtn, 'is-on']} data-value="default">关系→称呼</button>
							<button type="button" class={segBtn} data-value="chain">称呼→关系</button>
						</div>
					</div>
				</div>

				<div class="mt-5 flex flex-wrap gap-3">
					<button type="button" id="calc-back" class={actionBtn}>回退</button>
					<button type="button" id="calc-clear" class={actionBtn}>清空</button>
				</div>
			</div>

			<!-- 右侧：结果展示 -->
			<aside class="lg:col-span-5 lg:sticky lg:top-24">
				<div
					class="flex min-h-[16rem] flex-col rounded-2xl border border-slate-200/80 bg-gradient-to-br from-white to-blue-50/40 p-6 shadow-sm sm:min-h-[20rem] dark:border-slate-700/80 dark:from-slate-900 dark:to-blue-950/20"
				>
					<div class="mb-4 flex items-center justify-between">
						<h2 class="text-sm font-semibold tracking-wide text-slate-600 uppercase dark:text-slate-300">
							计算结果
						</h2>
						<span class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-medium text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-400">
							本地运行
						</span>
					</div>
					<div
						id="calc-result"
						class="empty flex flex-1 flex-wrap content-center items-center gap-2 rounded-xl border border-dashed border-slate-200/90 bg-white/60 px-5 py-6 dark:border-slate-600/80 dark:bg-slate-950/40"
					>
						<span class="calc-result-placeholder text-center text-slate-400 dark:text-slate-500">
							输入后点「计算」，或点击上方示例
						</span>
					</div>
				</div>

				<p class="mt-4 text-center text-xs leading-relaxed text-slate-400 dark:text-slate-500">
					算法基于
					<a
						class="text-brand hover:underline dark:text-blue-400"
						href="https://github.com/mumuy/relationship"
						target="_blank"
						rel="noopener">relationship.js</a
					>
					· 分享链接
					<code class="rounded-md bg-slate-100 px-1.5 py-0.5 dark:bg-slate-800">?q=妈妈的妈妈的兄弟</code>
				</p>
			</aside>
		</div>
	</div>
</div>

<script src="../scripts/calc.ts"></script>
