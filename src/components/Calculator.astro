---
import { CHAIN_KEYS, CHAIN_EXAMPLES, SITE } from '../data/site';

interface Props {
  variant?: 'full' | 'mini';
}

const { variant = 'full' } = Astro.props;
const isFull = variant === 'full';

const MODES = [
  { key: 'default', name: '通用' },
  { key: 'north', name: '北方' },
  { key: 'guangdong', name: '广东' },
];

const EXAMPLES = [
  ...CHAIN_EXAMPLES.map((item) => ({ text: item.chain, chain: item.chain, label: item.label })),
  { text: '舅妈如何称呼外婆？', chain: '', label: '整句提问' },
  { text: '七舅姥爷是谁', chain: '', label: '称谓反查' },
];

const shownExamples = isFull ? EXAMPLES : EXAMPLES.slice(0, 4);
---

<section
  class:list={['calc', !isFull && 'calc--mini']}
  data-calc
  data-variant={variant}
  data-sync-url={isFull ? 'true' : 'false'}
  aria-label="亲戚称呼计算器"
>
  <div class="calc__result" data-result>
    <div class="result__label">
      <span>计算结果</span>
      <span class="result__badge">本地计算 · 不上传</span>
    </div>
    <div class="result__main is-empty" data-result-main>
      点单字拼一条关系链，或直接输入后按「计算」。
    </div>
    <div class="result__alt" data-result-alt></div>
    <div class="result__meta" data-result-meta>
      例如「父的父」= 爷爷，「母的母的兄」= 舅外公。
    </div>
    <div class="result__actions">
      <button class="result__btn" type="button" data-copy-result>复制结果</button>
      {!isFull && <a class="result__btn" href="/calc/">打开完整计算器 →</a>}
    </div>
    {!isFull && (
      <p class="result__hint">支持关系链、称呼反查、北方/广东叫法与反向视角。</p>
    )}
  </div>

  <div class="calc__main panel">
    <div class="calc__label">
      <span>关系 / 称呼</span>
      <small>可直接输入「妈妈的妈妈的兄弟」，或点下方单字拼关系链</small>
    </div>
    <div class="calc__input-row">
      <input
        class="calc__input"
        data-input
        type="text"
        aria-label="关系或称呼"
        placeholder="妈妈的妈妈的兄弟，或：七舅姥爷"
        autocomplete="off"
        spellcheck="false"
      />
      <button class="btn btn--primary calc__submit" type="button" data-submit>计算</button>
    </div>

    <div class="calc__chain" data-chain>
      <span class="calc__chain-empty">关系链：尚未输入</span>
    </div>

    <div class="calc__keys-head">
      <span>单字关系链</span>
      <span class="calc__keys-hint" data-keys-hint>单字可无限组合</span>
    </div>
    <div class="calc__keys" data-keys>
      {CHAIN_KEYS.map((key) => (
        <button class="calc__key" type="button" data-key={key.v} title={key.hint}>
          <span class="calc__key-char">{key.v}</span>
          <span class="calc__key-hint">{key.hint}</span>
        </button>
      ))}
    </div>

    <div class="calc__toolbar">
      <button class="calc__tool" type="button" data-tool="back">← 回退一字</button>
      <button class="calc__tool" type="button" data-tool="clear">清空</button>
      {isFull && <button class="calc__tool" type="button" data-copy-result>复制结果</button>}
    </div>

    <div class="calc__examples">
      <span class="calc__examples-label">试试</span>
      {shownExamples.map((ex) => (
        <button
          class="calc__example"
          type="button"
          data-example={ex.text}
          data-chain={ex.chain || undefined}
        >
          {ex.label === ex.text ? ex.text : `${ex.label} · ${ex.text}`}
        </button>
      ))}
    </div>

    {isFull && (
      <div class="calc__options">
        <div>
          <span class="calc__opt-label">我的性别</span>
          <div class="seg" data-option="sex">
            <button class="seg__btn is-on" type="button" data-value="-1">不限</button>
            <button class="seg__btn" type="button" data-value="1">男</button>
            <button class="seg__btn" type="button" data-value="0">女</button>
          </div>
        </div>
        <div>
          <span class="calc__opt-label">称呼方向</span>
          <div class="seg" data-option="reverse">
            <button class="seg__btn is-on" type="button" data-value="false">我称呼对方</button>
            <button class="seg__btn" type="button" data-value="true">对方称呼我</button>
          </div>
        </div>
        <div>
          <span class="calc__opt-label">计算类型</span>
          <div class="seg" data-option="type">
            <button class="seg__btn is-on" type="button" data-value="default">关系 → 称呼</button>
            <button class="seg__btn" type="button" data-value="chain">称呼 → 关系</button>
          </div>
        </div>
        <div>
          <span class="calc__opt-label">叫法地区</span>
          <select class="select" data-option="mode" aria-label="叫法地区">
            {MODES.map((m) => <option value={m.key}>{m.name}</option>)}
          </select>
        </div>
        <div>
          <span class="calc__opt-label">结果偏好</span>
          <div class="seg" data-option="optimal">
            <button class="seg__btn is-on" type="button" data-value="false">全部叫法</button>
            <button class="seg__btn" type="button" data-value="true">只给最简</button>
          </div>
        </div>
        <div>
          <span class="calc__opt-label">分享</span>
          <button class="btn btn--outline btn--sm" type="button" data-copy-link style="width:100%">
            复制带参数的链接
          </button>
        </div>
      </div>
    )}
  </div>

  {isFull && (
    <div class="calc__side">
      <div class="aside-card">
        <h3 class="aside-card__title">单字速记</h3>
        <p style="font-size:.83rem;line-height:1.85;color:var(--ink-2)">
          父=爸爸 · 母=妈妈 · 兄/弟=哥哥/弟弟 · 姐/妹=姐姐/妹妹 · 夫/妻=老公/老婆 · 子/女=儿子/女儿
        </p>
        <p style="font-size:.83rem;line-height:1.85;color:var(--ink-2);margin-top:8px">
          链末端是男的，自动屏蔽「夫」；是女的，屏蔽「妻」。兄、弟、姐、妹等键始终可用。
        </p>
      </div>
      <div class="calc__history" data-history hidden>
        <div class="calc__history-head">
          <span>最近查过</span>
          <button type="button" data-history-clear>清空</button>
        </div>
        <div class="calc__history-list" data-history-list></div>
      </div>
      <p class="result__hint" style="color:var(--muted);margin-top:14px;opacity:1">
        算法来自 <a href={SITE.lib} target="_blank" rel="noopener" style="text-decoration:underline">relationship.js</a>
        v{SITE.libVersion}（MIT）；北方 / 广东叫法使用该库官方方言数据。各地习惯不同，结果供参考。
      </p>
    </div>
  )}
</section>

<style>
  .calc--mini {
    grid-template-columns: 1fr;
  }
  .calc--mini .calc__result {
    min-height: 0;
    padding: 22px;
  }
  .calc--mini .result__main {
    margin-top: 16px;
  }
  .calc--mini .result__actions {
    margin-top: 18px;
  }
  .calc--mini .calc__examples {
    margin-top: 14px;
  }
</style>

<script src="../scripts/calculator.js"></script>
