---
import { Image } from 'astro:assets';
import DraftContentNotice from '../../node_modules/@astrojs/starlight/components/DraftContentNotice.astro';
import HeroIllustration from './HeroIllustration.astro';

const PAGE_TITLE_ID = '_top';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, image, actions = [] } = data.hero || {};

const isHome = Astro.url.pathname.replace(/\/$/, '') === '';
const useNetworkIllustration = isHome && !image;

const imageAttrs = {
	loading: 'eager' as const,
	decoding: 'async' as const,
	width: 400,
	height: 400,
	alt: image?.alt || '',
};

let darkImage: ImageMetadata | undefined;
let lightImage: ImageMetadata | undefined;
let rawHtml: string | undefined;
if (image) {
	if ('file' in image) {
		darkImage = image.file;
	} else if ('dark' in image) {
		darkImage = image.dark;
		lightImage = image.light;
	} else {
		rawHtml = image.html;
	}
}

const primaryAction = actions.find((a) => a.variant !== 'minimal') ?? actions[0];
const secondaryAction = actions.find((a) => a.variant === 'minimal') ?? actions[1];
---

<div class="hero relative grid grid-cols-1 items-center gap-10 pb-6 lg:grid-cols-2 lg:gap-16 lg:pb-10 lg:pt-4">
	<div
		class="pointer-events-none absolute -top-20 left-1/2 -z-10 h-72 w-[120%] -translate-x-1/2 bg-[radial-gradient(ellipse_at_center,rgba(37,99,235,0.12),transparent_70%)] dark:bg-[radial-gradient(ellipse_at_center,rgba(37,99,235,0.2),transparent_70%)]"
		aria-hidden="true"
	>
	</div>

	<div class="flex flex-col gap-8 text-center lg:text-left">
		<div class="flex flex-col items-center gap-5 lg:items-start">
			{
				isHome && (
					<span class="inline-flex items-center gap-2 rounded-full border border-blue-200/80 bg-blue-50/80 px-3.5 py-1 text-xs font-semibold tracking-wide text-brand-dark dark:border-blue-800/60 dark:bg-blue-950/50 dark:text-blue-300">
						<span class="h-1.5 w-1.5 rounded-full bg-brand dark:bg-blue-400" />
						中国亲戚关系 · 浏览器本地计算
					</span>
				)
			}
			<h1
				id={PAGE_TITLE_ID}
				data-page-title
				class="max-w-[14ch] text-[clamp(2rem,calc(0.5rem+5vw),3.75rem)] font-bold leading-[1.12] tracking-tight text-slate-900 dark:text-white"
				set:html={title}
			/>
			{data.draft && <DraftContentNotice />}
			{
				tagline && (
					<div
						class="max-w-xl text-[clamp(1rem,0.5vw+0.95rem,1.2rem)] leading-[1.75] text-slate-600 dark:text-slate-300"
						set:html={tagline}
					/>
				)
			}
			{
				isHome && (
					<ul class="flex flex-wrap justify-center gap-2 lg:justify-start">
						{['本地计算', '反向查询', '自然语言'].map((item) => (
							<li class="rounded-full bg-slate-100/90 px-3 py-1 text-xs font-medium text-slate-600 dark:bg-slate-800/80 dark:text-slate-300">
								{item}
							</li>
						))}
					</ul>
				)
			}
		</div>

		{
			actions.length > 0 && (
				<div class="flex flex-wrap items-center justify-center gap-3 lg:justify-start">
					{
						primaryAction && (
							<a
								href={primaryAction.link}
								class="inline-flex items-center gap-2 rounded-xl bg-brand px-6 py-3.5 text-base font-semibold text-white no-underline shadow-lg shadow-blue-500/25 transition hover:bg-brand-dark hover:shadow-xl hover:shadow-blue-500/30"
							>
								{primaryAction.text}
								<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
									<path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</a>
						)
					}
					{
						secondaryAction && (
							<a
								href={secondaryAction.link}
								class="inline-flex items-center gap-2 rounded-xl border border-slate-200/90 bg-white/90 px-6 py-3.5 text-base font-semibold text-slate-700 no-underline shadow-sm transition hover:border-slate-300 hover:bg-white dark:border-slate-600 dark:bg-slate-900/90 dark:text-slate-200 dark:hover:border-slate-500 dark:hover:bg-slate-800"
							>
								<svg class="h-4 w-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
									<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H18v18H6.5A2.5 2.5 0 0 1 4 18.5v-13Z" />
									<path d="M8 7h8M8 11h6M8 15h4" />
								</svg>
								{secondaryAction.text}
							</a>
						)
					}
				</div>
			)
		}
	</div>

	<div class="flex w-full items-center justify-center lg:justify-end">
		<div class="relative w-full max-w-md lg:max-w-lg">
			<div
				class="pointer-events-none absolute -inset-4 rounded-[2rem] bg-gradient-to-br from-blue-200/40 via-transparent to-orange-100/30 blur-2xl dark:from-blue-900/30 dark:to-orange-900/10"
				aria-hidden="true"
			>
			</div>
			<div class="relative">
				{useNetworkIllustration && <HeroIllustration />}
				{
					darkImage && (
						<Image
							src={darkImage}
							{...imageAttrs}
							class:list={[
								'mx-auto h-auto w-full max-w-sm object-contain lg:max-w-full',
								Boolean(lightImage) && 'light:sl-hidden',
							]}
						/>
					)
				}
				{
					lightImage && (
						<Image
							src={lightImage}
							{...imageAttrs}
							class="dark:sl-hidden mx-auto h-auto w-full max-w-sm object-contain lg:max-w-full"
						/>
					)
				}
				{rawHtml && <div class="mx-auto w-full max-w-sm lg:max-w-full" set:html={rawHtml} />}
			</div>
		</div>
	</div>
</div>
