---
import { Image } from 'astro:assets';
import qrcodeImg from '../assets/qrcode.jpg';
---

<div class="qq-hero-qr mx-auto w-full max-w-[16.5rem] sm:max-w-[18rem]">
	<div
		class="qq-hero-qr__card relative overflow-hidden rounded-lg border border-stone-300/90 bg-white/95 dark:border-stone-600/60 dark:bg-night-card/95"
	>
		<div
			class="flex items-center gap-2.5 border-b border-stone-200/90 px-4 py-3 dark:border-stone-700/70"
		>
			<span
				class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-[#07C160]"
				aria-hidden="true"
			>
				<svg class="h-4 w-4 text-white" viewBox="0 0 24 24" fill="currentColor">
					<path
						d="M8.5 12.5c0 .83-.67 1.5-1.5 1.5S5.5 13.33 5.5 12.5 6.17 11 7 11s1.5.67 1.5 1.5zm7 0c0 .83-.67 1.5-1.5 1.5s-1.5-.67-1.5-1.5.67-1.5 1.5-1.5 1.5.67 1.5 1.5zM12 2C6.48 2 2 5.58 2 10c0 2.03.94 3.87 2.5 5.17L4 20l4.86-1.5C9.83 18.78 10.89 19 12 19c5.52 0 10-3.58 10-8s-4.48-8-10-8z"
					></path>
				</svg>
			</span>
			<div class="min-w-0">
				<p class="font-display text-sm font-semibold leading-tight text-ink dark:text-stone-100">
					微信小程序
				</p>
				<p class="truncate text-[11px] leading-tight text-ink-muted dark:text-stone-400">
					亲戚百科 · 随身查称呼
				</p>
			</div>
		</div>

		<div class="px-4 pb-3 pt-4">
			<div class="qq-hero-qr__scan relative rounded-md bg-white p-3">
				<div
					class="pointer-events-none absolute inset-3 rounded border border-dashed border-stone-200/90"
					aria-hidden="true"
				>
				</div>
				<Image
					src={qrcodeImg}
					alt="亲戚百科微信小程序二维码，扫码打开小程序"
					width={430}
					height={430}
					loading="eager"
					decoding="async"
					class="relative z-10 w-full rounded"
				/>
			</div>
		</div>

		<div class="px-4 pb-4 text-center">
			<p class="text-xs font-medium text-ink-muted dark:text-stone-300">微信扫一扫</p>
			<p class="mt-0.5 text-[11px] text-stone-400 dark:text-stone-500">
				过年走亲戚，称呼不求人
			</p>
		</div>
	</div>
</div>
