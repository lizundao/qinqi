---
import { Image } from 'astro:assets';
import qrcodeImg from '../assets/qrcode.jpg';
---

<div class="qq-hero-qr mx-auto w-full max-w-[16.5rem] sm:max-w-[18rem]">
	<div
		class="pointer-events-none absolute -inset-6 rounded-[2.5rem] bg-[radial-gradient(circle_at_50%_45%,rgba(37,99,235,0.18),transparent_68%)] blur-xl dark:bg-[radial-gradient(circle_at_50%_45%,rgba(37,99,235,0.28),transparent_70%)]"
		aria-hidden="true"
	>
	</div>

	<div
		class="qq-hero-qr__card relative overflow-hidden rounded-2xl border border-slate-200/90 bg-white/95 shadow-[0_20px_50px_-12px_rgba(37,99,235,0.18)] backdrop-blur-sm dark:border-slate-600/50 dark:bg-slate-800/90 dark:shadow-[0_24px_60px_-12px_rgba(0,0,0,0.55),0_0_0_1px_rgba(148,163,184,0.08)]"
	>
		<div
			class="flex items-center gap-2.5 border-b border-slate-100 px-4 py-3 dark:border-slate-700/70 dark:bg-slate-800/95"
		>
			<span
				class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-[#07C160] shadow-sm"
				aria-hidden="true"
			>
				<svg class="h-4 w-4 text-white" viewBox="0 0 24 24" fill="currentColor">
					<path
						d="M8.5 12.5c0 .83-.67 1.5-1.5 1.5S5.5 13.33 5.5 12.5 6.17 11 7 11s1.5.67 1.5 1.5zm7 0c0 .83-.67 1.5-1.5 1.5s-1.5-.67-1.5-1.5.67-1.5 1.5-1.5 1.5.67 1.5 1.5zM12 2C6.48 2 2 5.58 2 10c0 2.03.94 3.87 2.5 5.17L4 20l4.86-1.5C9.83 18.78 10.89 19 12 19c5.52 0 10-3.58 10-8s-4.48-8-10-8z"
					></path>
				</svg>
			</span>
			<div class="min-w-0">
				<p class="text-sm font-semibold leading-tight text-slate-800 dark:text-slate-100">
					微信小程序
				</p>
				<p class="truncate text-[11px] leading-tight text-slate-500 dark:text-slate-400">
					亲戚百科 · 随身查称呼
				</p>
			</div>
		</div>

		<div class="px-4 pb-3 pt-4 dark:bg-slate-800/60">
			<div class="qq-hero-qr__scan relative rounded-xl bg-white p-3 dark:bg-white">
				<div
					class="pointer-events-none absolute inset-3 rounded-lg border border-dashed border-slate-200/90 dark:border-slate-300/50"
					aria-hidden="true"
				>
				</div>
				<Image
					src={qrcodeImg}
					alt="亲戚百科微信小程序二维码，扫码打开小程序"
					width={430}
					height={430}
					loading="eager"
					decoding="async"
					class="relative z-10 w-full rounded-lg"
				/>
			</div>
		</div>

		<div class="px-4 pb-4 text-center">
			<p class="text-xs font-medium text-slate-600 dark:text-slate-300">微信扫一扫</p>
			<p class="mt-0.5 text-[11px] text-slate-400 dark:text-slate-500">
				过年走亲戚，称呼不求人
			</p>
		</div>
	</div>
</div>
