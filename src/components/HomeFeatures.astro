---
const features = [
	{
		title: '亲戚关系计算器',
		desc: '关系链、称呼正反查，本地即时出结果。聚会前查一查，别再叫错人。',
		href: '/calc/',
		cta: '立即使用',
		accent: 'brand' as const,
		highlight: '七舅姥爷 → 舅外公',
	},
	{
		title: '亲戚常识',
		desc: '俗语典故、亲缘辨析，弄懂谁近谁远、为何讲究、怎样相处更有分寸。',
		href: '/articles/',
		cta: '查看全部',
		accent: 'warm' as const,
		highlight: '亲疏 · 血缘 · 相处',
	},
];
---

<section class="grid w-full gap-4 md:grid-cols-2 md:gap-5">
	{
		features.map((item) => (
			<a
				class:list={[
					'qq-feature group flex flex-col gap-3 rounded-lg border border-stone-200/90 bg-white/90 p-5 text-inherit no-underline transition dark:border-stone-700/80 dark:bg-night-card/90',
					item.accent === 'brand' && 'border-l-4 border-l-brand',
					item.accent === 'warm' && 'border-l-4 border-l-warm',
				]}
				href={item.href}
			>
				<div class="flex flex-col gap-1.5">
					<h3 class="font-display text-[1.0625rem] font-semibold leading-snug text-ink dark:text-stone-100">
						{item.title}
					</h3>
					<p
						class:list={[
							'text-[0.8125rem] font-medium',
							item.accent === 'brand' && 'text-brand/90 dark:text-red-400/90',
							item.accent === 'warm' && 'text-warm/90 dark:text-amber-400/90',
						]}
					>
						{item.highlight}
					</p>
					<p class="text-[0.9375rem] leading-[1.65] text-ink-muted dark:text-stone-400">{item.desc}</p>
				</div>

				<span
					class:list={[
						'inline-flex items-center gap-1.5 text-sm font-medium transition group-hover:gap-2',
						item.accent === 'brand' && 'text-indigo group-hover:text-brand dark:text-stone-400 dark:group-hover:text-red-400',
						item.accent === 'warm' && 'text-indigo group-hover:text-warm dark:text-stone-400 dark:group-hover:text-amber-400',
					]}
				>
					{item.cta}
					<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
						<path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</span>
			</a>
		))
	}
</section>
