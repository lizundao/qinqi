---
import BaseLayout from '../layouts/BaseLayout.astro';
import Calculator from '../components/Calculator.astro';
import CheatSheet from '../components/CheatSheet.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Faq from '../components/Faq.astro';
import MiniProgramCard from '../components/MiniProgramCard.astro';
import { SITE } from '../data/site';
import { TOPICS, topicHref } from '../data/topics';
import { FAQ } from '../data/faq';
import { getArticles, getTopicGroups } from '../utils/articles';

const articles = await getArticles();
const groups = await getTopicGroups();
const featured = articles.slice(0, 6);

const appLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: SITE.appName,
  url: new URL('/calc/', SITE.url).href,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web / 微信小程序',
  inLanguage: 'zh-CN',
  description:
    '输入关系链或中文称呼，本地计算正确的亲戚称谓；支持称呼反查、反向视角与通用/北方/广东三种叫法。',
  featureList: ['关系链计算', '称呼反查', '反向称呼', '北方方言', '广东方言', '结果分享链接'],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY' },
  isAccessibleForFree: true,
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout
  title={SITE.name}
  description={SITE.description}
  keywords="亲戚称呼计算器,亲戚关系,中国亲戚称谓,称呼速查,堂表亲,relationship.js"
  jsonLd={[appLd, faqLd]}
>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__content">
        <span class="eyebrow">中国亲戚关系 · 在线工具</span>
        <h1 class="hero__title">一句关系链，<br /><em>算出该怎么叫</em></h1>
        <p class="hero__lede">
          爸爸的妈妈的兄弟该怎么叫？「七舅姥爷」又是谁？把关系链拼出来，答案立刻出现。
          支持称呼反查、北方与广东叫法，全部在你本机计算。
        </p>
        <div class="hero__badges">
          <span class="hero__badge">本地计算 · 不上传</span>
          <span class="hero__badge">十单字无限组合</span>
          <span class="hero__badge">通用 / 北方 / 广东</span>
        </div>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/calc/">打开完整计算器 →</a>
          <a class="btn btn--outline" href="/cheatsheet/">查看称呼速查表</a>
        </div>
        <p class="hero__note">算法：relationship.js v{SITE.libVersion}（MIT）· 与微信小程序同源</p>
        <div class="stat-row">
          <div class="stat">
            <div class="stat__num">10</div>
            <div class="stat__label">关系原语</div>
          </div>
          <div class="stat">
            <div class="stat__num">3</div>
            <div class="stat__label">叫法地区</div>
          </div>
          <div class="stat">
            <div class="stat__num">{articles.length}</div>
            <div class="stat__label">常识文章</div>
          </div>
        </div>
      </div>

      <div class="hero__aside">
        <Calculator variant="mini" />
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <MiniProgramCard />
    </div>
  </section>

  <section class="section section--tint" id="cheatsheet">
    <div class="container">
      <div class="section__head">
        <div>
          <h2 class="section__title">常见称呼，直接给答案</h2>
          <p class="section__desc">下面每一条都由计算核心实际算出，点开可在计算器里改写成你自己的关系链。</p>
        </div>
        <a class="section__more" href="/cheatsheet/">全部 23 条速查 →</a>
      </div>
      <CheatSheet limit={8} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__head">
        <div>
          <h2 class="section__title">三步，把关系理清楚</h2>
          <p class="section__desc">不用背称谓表，也不用记「七大姑八大姨」的顺口溜。</p>
        </div>
      </div>
      <div class="steps">
        <div class="step">
          <span class="step__num">1</span>
          <h3 class="step__title">拼关系链</h3>
          <p class="step__desc">点「父、母、兄、姐、夫、妻、弟、妹、子、女」十个单字，或者直接输入「妈妈的妈妈的兄弟」。</p>
        </div>
        <div class="step">
          <span class="step__num">2</span>
          <h3 class="step__title">选视角与叫法</h3>
          <p class="step__desc">切换「我称呼对方 / 对方称呼我」、通用 / 北方 / 广东叫法；男不能接「夫」、女不能接「妻」会自动屏蔽。</p>
        </div>
        <div class="step">
          <span class="step__num">3</span>
          <h3 class="step__title">拿到结果并分享</h3>
          <p class="step__desc">结果卡给出主称呼与备选叫法，可复制结果，或复制带参数的链接发给家人一起看。</p>
        </div>
      </div>

      <div class="section__head" style="margin-top:52px">
        <div>
          <h2 class="section__title">亲戚常识，按栏目读</h2>
          <p class="section__desc">{articles.length} 篇文章按主题归到 {groups.length} 个栏目，慢慢读，不必从头翻。</p>
        </div>
        <a class="section__more" href="/articles/">进入文章库 →</a>
      </div>
      <div class="topic-grid">
        {TOPICS.map((topic) => {
          const count = groups.find((g) => g.topic.slug === topic.slug)?.count ?? 0;
          return (
            <a class="topic-card" href={topicHref(topic.slug)}>
              <div class="topic-card__top">
                <span class="topic-card__icon">{topic.title.slice(0, 1)}</span>
                <span class="topic-card__count">{count} 篇</span>
              </div>
              <h3 class="topic-card__title">{topic.title}</h3>
              <p class="topic-card__desc">{topic.description}</p>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="section__head">
        <div>
          <h2 class="section__title">为什么这么叫</h2>
          <p class="section__desc">称呼背后是亲疏、血缘与相处分寸，这里挑几篇新的。</p>
        </div>
        <a class="section__more" href="/articles/">查看全部文章 →</a>
      </div>
      <div class="article-grid">
        {featured.map((article) => <ArticleCard article={article} />)}
      </div>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="container">
      <div class="section__head">
        <div>
          <h2 class="section__title">常见问题</h2>
          <p class="section__desc">关于算法、隐私、方言与用法，先把话说清楚。</p>
        </div>
      </div>
      <Faq />
    </div>
  </section>
</BaseLayout>
