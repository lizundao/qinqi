---
import { render } from 'astro:content';
import ToolLayout from '../../layouts/ToolLayout.astro';
import ArticleDetail from '../../components/ArticleDetail.astro';
import { getArticleBySlug, getArticleSlug, getArticles } from '../../utils/articles';

export async function getStaticPaths() {
	const articles = await getArticles();

	return articles.map((entry) => ({
		params: { slug: getArticleSlug(entry) },
	}));
}

const slug = Astro.params.slug!;
const entry = await getArticleBySlug(slug);

if (!entry) {
	return Astro.redirect('/404');
}

const { Content } = await render(entry);
---

<ToolLayout title={entry.data.title} description={entry.data.description}>
	<ArticleDetail
		title={entry.data.title}
		description={entry.data.description}
		date={entry.data.date}
		tags={entry.data.tags}
	>
		<Content />
	</ArticleDetail>
</ToolLayout>
