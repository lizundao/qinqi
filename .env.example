# AI 写文章（npm run article:ai）
# OpenAI 兼容接口：硅基流动、DeepSeek 官方、其他中转均可

# 必填
ARTICLE_AI_API_KEY=
ARTICLE_AI_BASE_URL=https://api.siliconflow.cn/v1
ARTICLE_AI_MODEL=deepseek-ai/DeepSeek-V3

# AI 生图封面（npm run article:covers:batch）
# 文档：https://api-docs.siliconflow.cn/docs/userguide/capabilities/images
# Kolors 配额：IPM=2，IPD=400
ARTICLE_IMAGE_MODEL=Kwai-Kolors/Kolors
ARTICLE_IMAGE_DELAY=32000

# ── 硅基流动示例 ──
# 控制台：https://cloud.siliconflow.cn/
# ARTICLE_AI_BASE_URL=https://api.siliconflow.cn/v1
# ARTICLE_AI_MODEL=deepseek-ai/DeepSeek-V3
# ARTICLE_AI_MODEL=Pro/deepseek-ai/DeepSeek-R1
# 模型列表见控制台「模型广场」中的模型 ID

# ── DeepSeek 官方示例 ──
# ARTICLE_AI_BASE_URL=https://api.deepseek.com
# ARTICLE_AI_MODEL=deepseek-chat

# 兼容旧变量名（与上面二选一即可）
# DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
